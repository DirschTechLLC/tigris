= form_with url: password_path(params[:token]), method: :patch, class: "space-y-4" do |f|
  .space-y-1
    = f.label :password, t(".password"), class: "field-label"
    = f.password_field :password, required: true, autocomplete: "new-password", class: "field-input"

  .space-y-1
    = f.label :password_confirmation, t(".confirmation"), class: "field-label"
    = f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "field-input"

  = f.submit t(".submit"), class: "btn-primary w-full"
