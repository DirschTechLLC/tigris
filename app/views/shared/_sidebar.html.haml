.w-64.shrink-0.bg-card.border-r.border-border.flex.flex-col.min-h-screen
  .px-4.py-5.border-b.border-border
    %span.text-sm.font-semibold.text-foreground= Current.organization&.name || "Tigris"

  %nav.flex-1.px-2.py-4.space-y-1
    - if Current.organization
      = nav_link_to t("nav.submissions"), organization_submissions_path(Current.organization)
      = nav_link_to t("nav.api_keys"), organization_api_keys_path(Current.organization)
      = nav_link_to t("nav.members"), organization_memberships_path(Current.organization)
      = nav_link_to t("nav.settings"), edit_organization_path(Current.organization)

  .px-4.py-4.border-t.border-border
    .text-xs.text-muted-foreground.truncate.mb-2= Current.user.email_address
    = button_to t("nav.sign_out"), session_path, method: :delete, class: "text-sm text-muted-foreground hover:text-foreground"
